<?xml version="1.0" encoding="UTF-8"?>
<sdx:platform sdx:vendor="xilinx.com"
              sdx:library="sdx"
              sdx:name="ZCU111"
              sdx:version="1.0"
              sdx:schemaVersion="1.0"
              xmlns:sdx="http://www.xilinx.com/sdx">
    <sdx:description>
ZCU111
    </sdx:description>
    <sdx:systemConfigurations sdx:defaultConfiguration="ZCU111">
        <sdx:configuration sdx:name="ZCU111"
                           sdx:displayName="ZCU111"
                           sdx:defaultProcessorGroup="standalone_domain"
                           sdx:runtimes="cpp">
            <sdx:description>ZCU111</sdx:description>
            <sdx:bootImages sdx:default="standard">
                <sdx:image sdx:name="standard"
                            sdx:bif="ZCU111/boot/ZCU111.bif"
                            sdx:readme="ZCU111/boot/generic.readme"
                            sdx:qemuArguments="ZCU111/qemu/pmu_args.txt:ZCU111/qemu/qemu_args.txt"
                            />
                <sdx:image sdx:name="standalone_domain"
                            sdx:bif="ZCU111/boot/ZCU111.bif"
                            sdx:readme="ZCU111/boot/generic.readme"
                            sdx:qemuArguments="ZCU111/standalone_domain/qemu/pmu_args.txt:ZCU111/standalone_domain/qemu/qemu_args.txt"
                            />
            </sdx:bootImages>
            <sdx:processorGroup sdx:name="standalone_domain"
                                sdx:displayName="standalone on psu_cortexa53_0"
                                sdx:cpuType="cortex-a53"
                                sdx:cpuInstance="psu_cortexa53_0">
                <sdx:os sdx:name="standalone"
                        sdx:displayName="standalone"
                        sdx:bspLibraryPaths="ZCU111/standalone_domain/bsplib/lib"
                        sdx:bspIncludePaths="ZCU111/standalone_domain/bspinclude/include"
                        sdx:bspConfig="ZCU111/standalone_domain/system.mss"
                />
            </sdx:processorGroup>
        </sdx:configuration>
    </sdx:systemConfigurations>
</sdx:platform>
