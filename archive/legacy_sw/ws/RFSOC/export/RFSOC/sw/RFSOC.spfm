<?xml version="1.0" encoding="UTF-8"?>
<sdx:platform sdx:vendor="xilinx.com"
              sdx:library="sdx"
              sdx:name="RFSOC"
              sdx:version="1.0"
              sdx:schemaVersion="1.0"
              xmlns:sdx="http://www.xilinx.com/sdx">
    <sdx:description>
RFSOC
    </sdx:description>
    <sdx:systemConfigurations sdx:defaultConfiguration="RFSOC">
        <sdx:configuration sdx:name="RFSOC"
                           sdx:displayName="RFSOC"
                           sdx:defaultProcessorGroup="standalone_domain"
                           sdx:runtimes="cpp">
            <sdx:description>RFSOC</sdx:description>
            <sdx:bootImages sdx:default="standard">
                <sdx:image sdx:name="standard"
                            sdx:bif="RFSOC/boot/RFSOC.bif"
                            sdx:readme="RFSOC/boot/generic.readme"
                            sdx:qemuArguments="RFSOC/qemu/pmu_args.txt:RFSOC/qemu/qemu_args.txt"
                            />
                <sdx:image sdx:name="standalone_domain"
                            sdx:bif="RFSOC/boot/RFSOC.bif"
                            sdx:readme="RFSOC/boot/generic.readme"
                            sdx:qemuArguments="RFSOC/standalone_domain/qemu/pmu_args.txt:RFSOC/standalone_domain/qemu/qemu_args.txt"
                            />
            </sdx:bootImages>
            <sdx:processorGroup sdx:name="standalone_domain"
                                sdx:displayName="standalone on psu_cortexa53_0"
                                sdx:cpuType="cortex-a53"
                                sdx:cpuInstance="psu_cortexa53_0">
                <sdx:os sdx:name="standalone"
                        sdx:displayName="standalone"
                        sdx:bspLibraryPaths="RFSOC/standalone_domain/bsplib/lib"
                        sdx:bspIncludePaths="RFSOC/standalone_domain/bspinclude/include"
                        sdx:bspConfig="RFSOC/standalone_domain/system.mss"
                />
            </sdx:processorGroup>
        </sdx:configuration>
    </sdx:systemConfigurations>
</sdx:platform>
